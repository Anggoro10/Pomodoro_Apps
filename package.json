{
  "name": "pomodoro-apps",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd Server && node server.js",
    "dev:client": "cd Client && npm run web",
    "build": "npx prisma generate --schema=Server/prisma/schema.prisma && cd Client && npm install && npm run build:web",
    "prisma:generate": "npx prisma generate --schema=Server/prisma/schema.prisma",
    "prisma:migrate": "cd Server && npx prisma migrate dev",
    "prisma:push": "cd Server && npx prisma db push",
    "prisma:studio": "cd Server && npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0"
  }
}
